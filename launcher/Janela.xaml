<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Tekken 5 Vulkan" Width="960" Height="600" MinWidth="850" MinHeight="520" WindowStartupLocation="CenterScreen"
 FontFamily="Segoe UI" FontSize="15" Foreground="#F6F2E9" Background="#1A1013" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#F5F4EC"/><Setter Property="Background" Value="#422127"/>
   <Setter Property="FontFamily" Value="Impact"/><Setter Property="FontStyle" Value="Italic"/><Setter Property="Padding" Value="20,10"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="surface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Opacity" Value=".82"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="surface" Property="Opacity" Value=".48"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="65"/><RowDefinition/><RowDefinition Height="42"/></Grid.RowDefinitions>
  <DockPanel Background="#1B1013" LastChildFill="False">
   <Button DockPanel.Dock="Right" Name="ReleaseButton" Margin="6,0,16,0" Padding="12,8" VerticalAlignment="Center" AutomationProperties.Name="Lançamentos"/>
   <TextBlock Text="TEKKEN  /  5" FontWeight="Bold" VerticalAlignment="Center" Margin="28,0,30,0"/>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Button Name="Inicio" Content="Início" Margin="0,0,6,0"/><Button Name="Graficos" Content="Gráficos" Margin="0,0,6,0"/><Button Name="Mods" Content="Mods" Margin="0,0,6,0"/><Button Name="Opcoes" Content="Configurações"/>
   </StackPanel>
  </DockPanel>
  <Grid Name="Home" Grid.Row="1" ClipToBounds="True">
   <Grid.Background>
    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
     <GradientStop Color="#160B0E" Offset="0"/><GradientStop Color="#380D12" Offset="1"/>
    </LinearGradientBrush>
   </Grid.Background>
   <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
   <Image Name="HomeCover" Grid.Column="1" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Stretch" IsHitTestVisible="False"/>
   <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="44,0,18,0">
    <TextBlock Text="TEKKEN 5" FontFamily="Impact" FontStyle="Italic" FontSize="60" Foreground="#F3E7DF"/>
    <TextBlock Name="HomePack" Foreground="#F5BD82" Margin="3,8,0,22"/>
    <Button Name="Play" Content="JOGAR" FontSize="19" Background="#E76E36" Foreground="#220E0C" MinWidth="188" HorizontalAlignment="Left"/>
   </StackPanel>
  </Grid>
  <StackPanel Name="Library" Grid.Row="1" Margin="34,25" Visibility="Collapsed">
   <TextBlock Text="Mods" FontSize="30" FontFamily="Impact" FontStyle="Italic"/><TextBlock Text="Patch de dados" FontWeight="SemiBold" Margin="0,20,0,4"/>
   <TextBlock Text="Selecione um arquivo de patch do ps2-native-recomp para Tekken 5 USA." TextWrapping="Wrap"/>
   <TextBlock Name="PatchName" TextWrapping="Wrap" Margin="0,18,0,12"/>
   <StackPanel Orientation="Horizontal"><Button Name="ChoosePatch" Content="Escolher patch…" Margin="0,0,8,0"/><Button Name="DisablePatch" Content="Desativar"/></StackPanel>
  </StackPanel>
  <StackPanel Name="VideoPage" Grid.Row="1" Margin="34,25" Visibility="Collapsed">
   <TextBlock Text="Gráficos" FontSize="30" FontFamily="Impact" FontStyle="Italic"/><TextBlock Text="Vulkan" Foreground="#E9C586" Margin="0,6,0,20"/>
   <TextBlock Text="Exibição" Margin="0,0,0,6"/><ComboBox Name="Display" HorizontalAlignment="Left" Width="235"/>
   <TextBlock Text="Proporção da tela" Margin="0,12,0,6"/><ComboBox Name="Aspect" AutomationProperties.Name="Proporção da tela" HorizontalAlignment="Left" Width="235"/>
    <TextBlock Text="Resolução interna nas lutas" Margin="0,18,0,6"/><ComboBox Name="Scale" AutomationProperties.Name="Resolução interna nas lutas" HorizontalAlignment="Left" Width="410"/>
    <CheckBox Name="WideCamera" Content="C&#226;mera ampliada em 16:9" Foreground="White" Margin="0,12,0,0"/>
    <CheckBox Name="VSync" Content="Sincronização vertical (VSync)" Foreground="White" Margin="0,16,0,0"/>
   <TextBlock Text="As alterações entram em vigor na próxima abertura do jogo." Foreground="#E0C9C2" Margin="0,16,0,0"/>
  </StackPanel>
  <StackPanel Name="Settings" Grid.Row="1" Margin="34,25" Visibility="Collapsed">
   <TextBlock Text="Configurações" FontSize="30" FontFamily="Impact" FontStyle="Italic"/>
   <TextBlock Text="Disco americano · SLUS-21059 · v1.00" FontWeight="SemiBold" Margin="0,22,0,6"/>
   <TextBlock Name="Disc" TextWrapping="Wrap" Margin="0,4,0,12"/><Button Name="Choose" HorizontalAlignment="Left" Content="Escolher ISO…"/>
   <TextBlock Text="Durante a luta, F1 abre o menu de controles." Foreground="#E0C9C2" Margin="0,20,0,0"/>
  </StackPanel>
  <Popup Name="ReleasePopup" Placement="Bottom" PlacementTarget="{Binding ElementName=ReleaseButton}" StaysOpen="False" AllowsTransparency="True" VerticalOffset="5">
   <Border Width="296" Padding="14" CornerRadius="5" BorderBrush="#8C4A42" BorderThickness="1" Background="#241518">
    <StackPanel>
     <TextBlock Text="Lançamentos" Foreground="#E9C586" FontSize="17" FontWeight="SemiBold" Margin="4,0,4,8"/>
     <ScrollViewer MaxHeight="234" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Name="ReleaseList"/></ScrollViewer>
     <TextBlock Name="ReleaseNote" Foreground="#F0DAD2" TextWrapping="Wrap" Margin="4,9,4,9"/>
     <Button Name="ReleaseReload" Content="Verificar atualizações" Padding="8,7"/>
    </StackPanel>
   </Border>
  </Popup>
  <Border Grid.Row="2" Background="#1B1013" Padding="24,0"><DockPanel><Button Name="CancelUpdate" DockPanel.Dock="Right" Content="Cancelar" Padding="12,3" Margin="8,5,0,5" Visibility="Collapsed"/><Grid>
   <TextBlock Name="Status" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#F0DAD2"/>
   <DockPanel Name="BuildActivity" Visibility="Collapsed" VerticalAlignment="Center">
    <TextBlock DockPanel.Dock="Left" Text="Compilando o jogo" Margin="0,0,16,0" Foreground="#F0DAD2"/>
    <ProgressBar Name="BuildProgress" Height="8" Foreground="#E76E36" Background="#422127" AutomationProperties.Name="Compilando o jogo"/>
   </DockPanel>
  </Grid></DockPanel></Border>
 </Grid>
</Window>
