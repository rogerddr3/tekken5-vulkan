+std::span<const ps2::UnitInfo> tekken2_units();
+std::span<const ps2::UnitInfo> tekken3_units();
+
+struct TekkenImage {
+    const char *argument;
+    std::uint32_t entry;
+    std::span<const ps2::UnitInfo> (*units)();
+};
+static constexpr TekkenImage tekken_images[] = {
+    {"p=d", 0x0010069c, devil_units},
+    {"p=1", 0x00100134, tekken1_units},
+    {"p=2", 0x00100134, tekken2_units},
+    {"p=3", 0x0016f61c, tekken3_units},
+};
+
+static bool select_tekken_program(std::uint32_t entry, std::span<const std::string> args) {
+    // The first two arcade titles have the same entry point. TK5DATA4's argument identifies the image.
+    static const TekkenImage *requested = nullptr;
+    ps2::unpacked_entry = 0;
+    if (entry == 0x00100008) {
+        register_generated_code();
+        requested = nullptr;
+        ps2::program_phase = ps2::ProgramPhase::Returned;
+    } else if (entry == 0x01e0001c) {
+        // TK5DATA4 copies its decrypted unpacker above its load segments before calling it.
+        const auto loader = loader_units(), stub = lzstub_units();
+        std::vector<ps2::UnitInfo> code(loader.begin(), loader.end());
+        code.insert(code.end(), stub.begin(), stub.end());
+        ps2::register_units(code.data(), code.size());
+        requested = nullptr;
+        for (const auto &image : tekken_images) {
+            if (std::find(args.begin(), args.end(), image.argument) != args.end()) {
+                requested = &image;
+                ps2::unpacked_entry = image.entry;
+                break;
+            }
+        }
+        ps2::program_phase = ps2::ProgramPhase::Secondary;
+    } else if (requested && entry == requested->entry) {
+        const auto code = requested->units();
+        ps2::register_units(code.data(), code.size());
+        ps2::program_phase = ps2::ProgramPhase::Secondary;
+    } else {
+        std::fprintf(stderr, "[exec] unknown entry %08X\n", entry);
+        return false;
+    }
+    return true;
+}
+#endif
 
