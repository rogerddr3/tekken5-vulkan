+struct ExecRequest {
+    std::string path;
+    std::uint32_t entry{}, gp{};
+    std::vector<std::string> args;
+};
+static std::optional<ExecRequest> pending_exec;
+
+static bool guest_string(std::uint32_t address, std::string &out) {
+    address &= 0x1fffffffu;
+    if (!address || address >= kRamSize) return false;
+    const char *start = reinterpret_cast<const char *>(g_ram + address);
+    const auto *end = static_cast<const char *>(std::memchr(start, 0, std::min(256u, kRamSize - address)));
+    if (!end) return false;
+    out.assign(start, end);
+    return true;
+}
+
+static void request_exec(Cpu &c, bool load) {
+    if (!select_exec_image) { halt("program asked to run another executable"); return; }
+    ExecRequest next;
+    if (load) {
+        if (!guest_string(arg(c, 0), next.path)) { halt("invalid LoadExecPS2 path"); return; }
+        next.args.push_back(next.path);
+    } else {
+        next.entry = arg(c, 0);
+        next.gp = arg(c, 1);
+    }
+    const auto argc = arg(c, load ? 1 : 2);
+    const auto argv = arg(c, load ? 2 : 3) & 0x1fffffffu;
+    if (argc > 16 || (argc && (!argv || argv > kRamSize - 4u * argc))) { halt("invalid exec arguments"); return; }
+    for (unsigned i = 0; i < argc; ++i) {
+        if (!guest_string(ld32(argv + 4u * i), next.args.emplace_back())) { halt("invalid exec argument"); return; }
+    }
+    pending_exec = std::move(next);
+    c.pc |= kUnwind;
+}
+
+static void enter_exec(Cpu &c) {
+    ExecRequest next = std::move(*pending_exec);
+    pending_exec.reset();
+    if (!next.path.empty()) {
+        std::vector<std::uint8_t> bytes;
+        std::string why;
+        if (!disc::read_exec_file(next.path, bytes, why) || !load_elf(bytes, next.entry)) {
+            halt("LoadExecPS2 failed for " + next.path + " " + why);
+            return;
+        }
+    }
+    if (!select_exec_image(next.entry, next.args)) { halt("no translation for requested executable"); return; }
+    std::fprintf(stderr, "[exec] entry %08X gp %08X", next.entry, next.gp);
+    for (const auto &s : next.args) std::fprintf(stderr, " [%s]", s.c_str());
+    std::fputc('\n', stderr);
+    // Keep the disc, clock and IOP running. Old EE threads must not run in the new program.
+    const auto budget = c.budget;
+    reset();
+    constexpr std::uint32_t argv = 0x800;
+    const auto argc = static_cast<std::uint32_t>(next.args.size());
+    std::uint32_t payload = argv + 4u * (argc + 1);
+    for (unsigned i = 0; i < argc; ++i) {
+        const auto &s = next.args[i];
+        if (payload + s.size() + 1 > kSyscallTable) { halt("exec arguments too large"); return; }
+        st32(argv + i * 4u, payload);
+        std::memcpy(g_ram + payload, s.c_str(), s.size() + 1);
+        payload += static_cast<std::uint32_t>(s.size() + 1);
+    }
+    st32(argv + argc * 4u, 0);
+    start_main_thread(next.entry, next.gp, argc, argv);
+    c.r[28].w[0] = next.gp;
+    c.r[29].w[0] = 0x01ffff00;
+    c.budget = budget;
+}
